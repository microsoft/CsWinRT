<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone microbenchmarks comparing the previous 'ComWrappers'-based 'IWeakReference' implementation
    ('StrategyBasedComWrappers' + '[GeneratedComClass]') with the thin native object that replaced it.
    This project does not reference CsWinRT: both implementations are copied here, so they can be compared side by side.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="$(BenchmarkDotNetVersion)" />
  </ItemGroup>

</Project>
