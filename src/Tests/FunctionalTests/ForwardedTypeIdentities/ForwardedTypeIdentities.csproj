<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(FunctionalTestsBuildTFMs)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <Platforms>x86;x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <PublishProfileFullPath>$(MSBuildProjectDirectory)\..\PublishProfiles\win-$(Platform).pubxml</PublishProfileFullPath>
    <CsWinRTMarshallingMode>strict</CsWinRTMarshallingMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Authoring\WinRT.SourceGenerator2\WinRT.SourceGenerator2.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU" />
    <ProjectReference Include="..\..\..\Projections\Windows\Windows.csproj" />
    <ProjectReference Include="..\ForwardedTypeIdentitiesLibrary\ForwardedTypeIdentitiesLibrary.csproj" GlobalPropertiesToRemove="TargetFramework;PublishAot;PublishTrimmed;IsAotCompatible;IsTrimmable" />
    <ProjectReference Include="..\ForwardedTypeIdentitiesNetStandard\ForwardedTypeIdentitiesNetStandard.csproj" GlobalPropertiesToRemove="TargetFramework;PublishAot;PublishTrimmed;IsAotCompatible;IsTrimmable" />

    <!-- The helpers have no WinRT references, but their System.ObjectModel/netstandard type references must be discovered. -->
    <CsWinRTMarshallingEnabledAssembly Include="ForwardedTypeIdentitiesLibrary" />
    <CsWinRTMarshallingEnabledAssembly Include="ForwardedTypeIdentitiesNetStandard" />
  </ItemGroup>
</Project>
