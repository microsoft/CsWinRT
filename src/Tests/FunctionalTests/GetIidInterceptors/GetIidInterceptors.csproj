<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(FunctionalTestsBuildTFMs)</TargetFrameworks>
    <Platforms>x86;x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <PublishProfileFullPath>$(MSBuildProjectDirectory)\..\PublishProfiles\win-$(Platform).pubxml</PublishProfileFullPath>
    <IlcGenerateMstatFile>true</IlcGenerateMstatFile>
    <IlcGenerateMapFile>true</IlcGenerateMapFile>
    <IlcFoldIdenticalMethodBodies>false</IlcFoldIdenticalMethodBodies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Authoring\WinRT.SourceGenerator2\WinRT.SourceGenerator2.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU" />
    <ProjectReference Include="..\..\..\Projections\Windows\Windows.csproj" />
  </ItemGroup>

  <Target Name="VerifyIidTrimming" AfterTargets="CopyNativeBinary" Condition="'$(PublishAot)' == 'true'">
    <Exec Command="pwsh -NoLogo -NoProfile -File &quot;$(MSBuildProjectDirectory)\verify-trimming.ps1&quot; -MstatPath &quot;$(IntermediateOutputPath)native\$(AssemblyName).mstat&quot; -AssemblyPath &quot;$(IntermediateOutputPath)$(TargetName).dll&quot;" />
  </Target>
</Project>
