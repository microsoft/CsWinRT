<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end test for the 'CsWinRTImplementWinMDTypes' authoring mode: implementing, in C#, Windows
    Runtime types that are declared in an existing '.winmd'. This is the 3.0 replacement for the 2.x
    'TestImplementExclusiveTo' test, which covered the equivalent 'CsWinRTPublicExclusiveToInterfaces'
    behavior by implementing the (then public) exclusive-to interfaces directly.

    The projection is referenced instead of the usual 'Test' projection: both project the 'TestComponent'
    metadata, so referencing both would define every type twice.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(FunctionalTestsBuildTFMs)</TargetFrameworks>
    <Platforms>x86;x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <PublishProfileFullPath>$(MSBuildProjectDirectory)\..\PublishProfiles\win-$(Platform).pubxml</PublishProfileFullPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Authoring\WinRT.SourceGenerator2\WinRT.SourceGenerator2.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU" />
    <ProjectReference Include="..\..\..\Projections\TestImplementWinMDTypes\TestImplementWinMDTypes.csproj" />
    <ProjectReference Include="..\..\..\Projections\Windows\Windows.csproj" />
  </ItemGroup>

</Project>
