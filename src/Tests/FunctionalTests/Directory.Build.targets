<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../../'))" />

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'GetIidInterceptors' or '$(MSBuildProjectName)' == 'GetIidInterceptorsFallback'">
    <!-- MSTAT/map verification needs every native method body to remain observable. -->
    <StackTraceSupport>true</StackTraceSupport>
  </PropertyGroup>

  <Target Name="CleanIntermediateDirs" Condition="'$(CleanIntermediateDirs)'=='true'" AfterTargets="Publish">
    <RemoveDir Directories="$(IntermediateOutputPath)" />
  </Target>

</Project>
