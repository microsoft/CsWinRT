<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Keep the netstandard facade identities in this library's actual compiled metadata. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Platforms>x86;x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <SimulateCsWinRTNugetReference>false</SimulateCsWinRTNugetReference>
    <CsWinRTEnabled>false</CsWinRTEnabled>
    <CsWinRTGenerateProjection>false</CsWinRTGenerateProjection>
    <CsWinRTGenerateInteropAssembly>false</CsWinRTGenerateInteropAssembly>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>
</Project>
