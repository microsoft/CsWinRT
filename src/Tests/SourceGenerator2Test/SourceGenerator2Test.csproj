<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64;x86</Platforms>
    <CsWinRTEnabled>false</CsWinRTEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Basic.Reference.Assemblies.Net100" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Authoring\WinRT.SourceGenerator2\WinRT.SourceGenerator2.csproj" SetPlatform="Platform=AnyCPU" />
    <ProjectReference Include="..\..\Projections\Windows\Windows.csproj" />
    <ProjectReference Include="..\..\Projections\WinAppSDK\WinAppSDK.csproj" />
    <ProjectReference Include="..\..\WinRT.Runtime2\WinRT.Runtime.csproj" />
  </ItemGroup>

  <!--
    The whole-SDK audit tests read the reference projection assemblies (under 'ref') and the WinUI metadata from disk. The UWP XAML projection
    is only built, not referenced: it can't be referenced next to the WinUI one, as they both define some of the same 'Windows.UI.Xaml' types.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Projections\Windows.UI.Xaml\Windows.UI.Xaml.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="Microsoft.WindowsAppSDK.Foundation" Version="[$(MicrosoftWinAppSDKFoundationVersion)]" />
    <PackageDownload Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="[$(MicrosoftWinAppSDKIxpVersion)]" />
    <PackageDownload Include="Microsoft.WindowsAppSDK.WinUI" Version="[$(MicrosoftWinAppSDKWinUIVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ProjectionsDirectory" Value="$(MSBuildThisFileDirectory)..\..\Projections" />
    <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
    <AssemblyMetadata Include="WinUIMetadataDirectories"
                      Value="$(NuGetPackageRoot)microsoft.windowsappsdk.winui\$(MicrosoftWinAppSDKWinUIVersion)\metadata;$(NuGetPackageRoot)microsoft.windowsappsdk.foundation\$(MicrosoftWinAppSDKFoundationVersion)\metadata;$(NuGetPackageRoot)microsoft.windowsappsdk.interactiveexperiences\$(MicrosoftWinAppSDKIxpVersion)\metadata\10.0.18362.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\nuget.config" Link="nuget.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
    
</Project>
