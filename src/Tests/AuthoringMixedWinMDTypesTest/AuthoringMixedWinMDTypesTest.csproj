<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A Windows Runtime component that both authors its own runtime classes (which go into its generated
    '.winmd') and implements runtime classes declared in existing metadata ('TestComponent', which do
    not). Both kinds have to be activatable from the same component, through the same entry point.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.1</TargetFramework>
    <Platforms>x64;x86</Platforms>
    <CsWinRTComponent>true</CsWinRTComponent>
    <IsTrimmable>true</IsTrimmable>
    <TargetPlatformResourceVersion>10.0.18362.0</TargetPlatformResourceVersion>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Projections\TestImplementWinMDTypes\TestImplementWinMDTypes.csproj" />
    <ProjectReference Include="..\..\Authoring\WinRT.SourceGenerator2\WinRT.SourceGenerator2.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU" />
  </ItemGroup>

</Project>
