<Project>

  <!--
    Shared Windows SDK metadata input for the two Windows SDK reference-projection smoke tests
    ('WindowsSdkProjection' and 'WindowsSdkXamlProjection'). Both generate a reference projection for
    the same Windows SDK '.winmd' metadata, exactly as the Windows SDK projection NuGet packages are
    produced; only their namespace include/exclude filters differ (the base SDK vs the 'Windows.UI.Xaml'
    split). This file is imported by both projects so the metadata staging lives in one place.

    It mirrors how 'src/WinRT.Sdk.Projection/WinRT.Sdk.Projection.csproj' obtains the SDK metadata: it
    downloads 'Microsoft.Windows.SDK.Contracts' and feeds its '.winmd' files into '@(CsWinRTInputs)',
    the input the reference projection generator ('cswinrtprojectionrefgen') reads.
  -->
  <PropertyGroup>
    <_SdkContractsPackageName>Microsoft.Windows.SDK.Contracts</_SdkContractsPackageName>

    <!--
      The 'Microsoft.Windows.SDK.Contracts' version for the 26100 Windows SDK. It is restored from the
      CsWinRTDependencies feed (see this folder's 'Directory.Build.props' 'RestoreSources'), so the smoke
      tests stay isolated from any machine-wide NuGet configuration.
    -->
    <_SdkContractsPackageVersion>10.0.26100.7705</_SdkContractsPackageVersion>
  </PropertyGroup>

  <!-- Download (but don't reference) the SDK metadata package; we only need its '.winmd' files. -->
  <ItemGroup>
    <PackageDownload Include="$(_SdkContractsPackageName)" Version="[$(_SdkContractsPackageVersion)]" />
  </ItemGroup>

  <!--
    Stage the SDK '.winmd' files as projection inputs before the reference projection generator runs.
    The metadata lives in the downloaded package's 'ref/netstandard2.0' folder. We exclude the union
    'Windows.winmd' (it would duplicate every contract) and the handful of contracts that the desktop
    'Microsoft.Windows.SDK.NET.Ref' package omits (phone/embedded/etc.), matching the official Windows
    SDK projection build in 'WinRT.Sdk.Projection.csproj'.
  -->
  <Target Name="_StageWindowsSdkContractsInputs" BeforeTargets="CsWinRTGenerateProjection">

    <PropertyGroup>
      <_SdkContractsWinMDFolder>$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)', '$(_SdkContractsPackageName)', '$(_SdkContractsPackageVersion)', 'ref', 'netstandard2.0'))</_SdkContractsWinMDFolder>
    </PropertyGroup>

    <Error Condition="!Exists('$(_SdkContractsWinMDFolder)')"
           Text="Windows SDK metadata folder not found at '$(_SdkContractsWinMDFolder)'. Check that the PackageDownload for $(_SdkContractsPackageName) $(_SdkContractsPackageVersion) succeeded." />

    <ItemGroup>
      <CsWinRTInputs Include="$(_SdkContractsWinMDFolder)*.winmd"
                     Exclude="$(_SdkContractsWinMDFolder)Windows.winmd;
                              $(_SdkContractsWinMDFolder)Windows.Embedded.DeviceLockdown.DeviceLockdownContract.winmd;
                              $(_SdkContractsWinMDFolder)Windows.Networking.NetworkOperators.NetworkOperatorsFdnContract.winmd;
                              $(_SdkContractsWinMDFolder)Windows.Phone.PhoneContract.winmd;
                              $(_SdkContractsWinMDFolder)Windows.Phone.StartScreen.DualSimTileContract.winmd;
                              $(_SdkContractsWinMDFolder)Windows.UI.WebUI.Core.WebUICommandBarContract.winmd" />
    </ItemGroup>
  </Target>
</Project>
