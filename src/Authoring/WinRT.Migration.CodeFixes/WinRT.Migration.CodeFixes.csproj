    <Nullable>enable</Nullable>
    <RootNamespace>WindowsRuntime.Migration</RootNamespace>
    <AssemblyName>WinRT.Migration.CodeFixes</AssemblyName>
    <IsPackable>false</IsPackable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\WinRT.Runtime\key.snk</AssemblyOriginatorKeyFile>
