  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <Compile Include="..\..\WinRT.SourceGenerator\Helpers\LegacyAttributeMigration.cs" Link="Helpers\LegacyAttributeMigration.cs" />
  </ItemGroup>
</Project>
