<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]WinRT\.(Runtime|SourceGenerator|Projection\.Writer|Generator\.Core|Generator\.Tasks)\.dll$</ModulePath>
        <ModulePath>.*[\\/]cswinrt(interopgen|projectiongen|projectionrefgen|winmdgen|implgen)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
    <CollectFromChildProcesses>true</CollectFromChildProcesses>
    <IncludeTestAssembly>false</IncludeTestAssembly>
    <EnableStaticManagedInstrumentation>false</EnableStaticManagedInstrumentation>
    <EnableDynamicManagedInstrumentation>true</EnableDynamicManagedInstrumentation>
    <EnableStaticNativeInstrumentation>false</EnableStaticNativeInstrumentation>
    <EnableDynamicNativeInstrumentation>false</EnableDynamicNativeInstrumentation>
  </CodeCoverage>
</Configuration>
